# ==============================================================================
# CONFIGURACIÓN DEL PIPELINE BMAD-YOUTUBE
# ==============================================================================

# Clave de API de Google Gemini / AI Studio (Requerido para CrewAI y Google Veo)
# Obtenla en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# Clave de API de OpenAI (Requerido para síntesis de voz TTS en generate_voice.py)
# Obtenla en: https://platform.openai.com/api-keys
OPENAI_API_KEY=tu_api_key_de_openai_aqui

# Modelos LLM para los Agentes CrewAI (Prefijo 'gemini/' requerido para LiteLLM)
GEMINI_MODEL_PRO=gemini/gemini-2.0-flash
GEMINI_MODEL_FLASH=gemini/gemini-2.0-flash

# Modelo para Generación de Video en Google GenAI SDK (Veo)
# Opciones comunes: veo-2.0-generate-001
VEO_MODEL_ID=veo-2.0-generate-001

# Configuración de voz TTS (alloy, shimmer, echo, fable, onyx, nova)
TTS_VOICE=alloy
TTS_SPEED=1.05
